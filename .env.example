# ==========================================
# CUTM VIDEO RESUME - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Admin Authentication (Protected Credentials)
ADMIN_USERNAME=team03
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_random_jwt_secret_here

# Database (MongoDB Connection String)
# Leave as mongodb://localhost:27017/cutm_video_resume or Atlas connection string.
# (If MongoDB service is offline, the backend gracefully falls back to persistent storage mode!)
MONGODB_URI=mongodb://localhost:27017/cutm_video_resume

# Optional Cloud Storage (Cloudinary / Supabase)
# Leave blank to use local server storage (backend/uploads/)
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
